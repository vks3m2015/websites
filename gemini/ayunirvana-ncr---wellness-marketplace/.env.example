# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Marketplace Production Configuration & Integrations
# Database connection string (PostgreSQL with PostGIS extension)
DATABASE_URL="postgresql://YOUR_DATABASE_USERNAME:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/YOUR_DATABASE_NAME?sslmode=require"

# JWT Secret for authentication tokens
JWT_SECRET="YOUR_JWT_SECRET_KEY"

# Object Storage for verified documents and portfolio images (Cloudflare R2 / AWS S3 / GCP Storage)
STORAGE_BUCKET="YOUR_STORAGE_BUCKET_NAME"
STORAGE_ACCESS_KEY="YOUR_STORAGE_ACCESS_KEY"
STORAGE_SECRET_KEY="YOUR_STORAGE_SECRET_KEY"
STORAGE_ENDPOINT="YOUR_STORAGE_ENDPOINT_URL"

# Payment Gateway (Razorpay / Stripe)
PAYMENT_API_KEY="YOUR_PAYMENT_GATEWAY_API_KEY"
PAYMENT_WEBHOOK_SECRET="YOUR_PAYMENT_WEBHOOK_SECRET"

# SMS / WhatsApp Notification Gateway (e.g. MSG91, Twilio)
SMS_GATEWAY_API_KEY="YOUR_SMS_GATEWAY_API_KEY"
SMS_SENDER_ID="YOUR_SMS_SENDER_ID"

# Maps & Geocoding API (Google Maps Platform or Mapbox)
MAPS_API_KEY="YOUR_MAPS_API_KEY"

# Platform Business Rules Configuration
PLATFORM_FEE_PERCENT="10"
TAX_GST_PERCENT="5"
MIN_CANCELLATION_NOTICE_HOURS="4"

